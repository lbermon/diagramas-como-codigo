@startuml
title Ciclo de vida del ejemplar de biblioteca

[*] --> Inactivo

Inactivo --> Activo : habilitado

state Activo {
    [*] --> Disponible

    Disponible --> Prestado : préstamo aprobado
    Prestado --> Revision : devolución recibida
    Revision --> Disponible : revisión aprobada
    Revision --> Mantenimiento : requiere reparación

    Disponible --> Mantenimiento : anomalía detectada
    Prestado --> Mantenimiento : daño reportado

    Mantenimiento --> Disponible : reparación finalizada
}

Activo --> Retirado : retirado del catálogo

@enduml