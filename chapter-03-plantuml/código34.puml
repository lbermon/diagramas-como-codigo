@startuml
title Diagrama de Secuencia - Preparar café

actor Usuario
participant Pantalla
participant SistemaInterno
participant MecanismoDeCafé

Usuario -> Pantalla : seleccionarTipoCafé()
Pantalla -> Usuario : mostrarOpciones()

Usuario -> Pantalla : confirmarPedido()
Pantalla -> SistemaInterno : enviarSolicitud()

SistemaInterno -> MecanismoDeCafé : iniciarPreparación()
MecanismoDeCafé -> MecanismoDeCafé : prepararCafé()

MecanismoDeCafé --> SistemaInterno : caféListo()
SistemaInterno --> Pantalla : notificarListo()
Pantalla --> Usuario : mostrarMensaje("Café listo")

@enduml